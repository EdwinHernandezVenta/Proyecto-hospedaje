    if(r.estado==='check-in'||r.estado==='check-out')return res.status(409).json({message:'No puedes cancelar una reserva en este estado'});
    await query("UPDATE reservas SET estado='cancelada' WHERE id=?",[r.id]);
    res.json({message:'Reserva cancelada'});
