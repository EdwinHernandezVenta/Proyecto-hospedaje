                autoComplete="new-password"
                required
              />
            </label>

            <label>
              <span>
                Confirmar contraseña *
              </span>

              <input
                type="password"
                name="confirmarContrasena"
                value={form.confirmarContrasena}
                onChange={cambiarCampo}
                placeholder="Repite tu contraseña"
                autoComplete="new-password"
                required
              />
