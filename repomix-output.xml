import {pool,query} from '../config/db.js';
import crypto from 'crypto';
import {reservationPdf} from '../utils/pdf.js';
import {rowsToXlsx} from '../utils/excel.js';
import {sendMail} from '../utils/mailer.js';

async function clientForUser(req){
  return (await query(
    'SELECT * FROM clientes WHERE correo=(SELECT correo FROM usuarios WHERE id=?)',
    [req.user.id]
  ))[0];
}

async function reservationForUser(req,id){
  const r=(await query(
    `SELECT r.*,c.correo cliente_correo
     FROM reservas r JOIN clientes c ON c.id=r.id_cliente
     WHERE r.id=?`,[id]
  ))[0];
  if(!r)return null;
  if(req.user.rol==='Cliente'){
    const c=await clientForUser(req);
    if(!c || c.id!==r.id_cliente)return {forbidden:true};
  }
  return r;
}

export async function availability(req,res,next){
  try{
    const {fecha_inicio,fecha_fin}=req.query;
    if(!fecha_inicio||!fecha_fin)return res.status(422).json({message:'Debes indicar fecha_inicio y fecha_fin'});
    const rows=await query(
      `SELECT h.* FROM habitaciones h
       WHERE h.estado='disponible'
       AND NOT EXISTS (
         SELECT 1 FROM reserva_detalle d
         JOIN reservas r ON r.id=d.id_reserva
         WHERE d.id_habitacion=h.id
         AND r.estado NOT IN ('cancelada','check-out')
         AND r.fecha_inicio < ? AND r.fecha_fin > ?
       )`,[fecha_fin,fecha_inicio]
    );
    res.json(rows);
  }catch(e){next(e)}
}

export async function create(req,res,next){
  const conn=await pool.getConnection();
  try{
    await conn.beginTransaction();
    let id_cliente=req.body.id_cliente;
    if(req.user.rol==='Cliente'){
      const c=await clientForUser(req);
      if(!c)return res.status(400).json({message:'El usuario no tiene perfil de cliente'});
      id_cliente=c.id;
    }
    if(!id_cliente)return res.status(422).json({message:'El cliente es obligatorio'});
    const {fecha_inicio,fecha_fin,numero_personas,valor_total,anticipo,detalles=[],notas}=req.body;
    if(new Date(fecha_fin)<=new Date(fecha_inicio))return res.status(422).json({message:'La fecha de salida debe ser posterior a la entrada'});
    if(Number(anticipo)!==Number(valor_total)*0.5)return res.status(422).json({message:'El anticipo debe ser exactamente el 50% del total'});
    if(!detalles.length)return res.status(422).json({message:'Debes seleccionar al menos una habitación'});
    for(const d of detalles.filter(x=>x.id_habitacion)){
      const clash=await conn.execute(
        `SELECT r.id FROM reservas r
         JOIN reserva_detalle rd ON rd.id_reserva=r.id
         WHERE rd.id_habitacion=? AND r.estado NOT IN ('cancelada','check-out')
         AND r.fecha_inicio < ? AND r.fecha_fin > ? FOR UPDATE`,
        [d.id_habitacion,fecha_fin,fecha_inicio]
      );
      if(clash[0].length)throw Object.assign(new Error('Habitación no disponible para esas fechas'),{status:409});
    }
    const numero_confirmacion='RES-'+Date.now()+'-'+crypto.randomBytes(3).toString('hex').toUpperCase();
    const [rr]=await conn.execute(
      `INSERT INTO reservas(id_cliente,fecha_inicio,fecha_fin,numero_personas,valor_total,anticipo,numero_confirmacion,notas)
       VALUES(?,?,?,?,?,?,?,?)`,
      [id_cliente,fecha_inicio,fecha_fin,numero_personas,valor_total,anticipo,numero_confirmacion,notas||null]
    );
    for(const d of detalles){
      await conn.execute(
        `INSERT INTO reserva_detalle(id_reserva,id_habitacion,id_servicio,id_paquete,cantidad,subtotal)
         VALUES(?,?,?,?,?,?)`,
        [rr.insertId,d.id_habitacion||null,d.id_servicio||null,d.id_paquete||null,d.cantidad||1,d.subtotal]
      );
    }
    await conn.commit();
    res.status(201).json({id:rr.insertId,numero_confirmacion,estado:'pendiente'});
  }catch(e){
    await conn.rollback();next(e);
  }finally{conn.release()}
}

export async function listReservations(req,res,next){
  try{
    let where='',params=[];
    if(req.user.rol==='Cliente'){
      where='WHERE r.id_cliente=(SELECT id FROM clientes WHERE correo=(SELECT correo FROM usuarios WHERE id=?))';
      params=[req.user.id];
    }
    const rows=await query(
      `SELECT r.*,CONCAT(c.nombre,' ',c.apellido) cliente,c.correo,
       (SELECT p.estado FROM pagos p WHERE p.id_reserva=r.id ORDER BY p.id DESC LIMIT 1) pago_estado,
       (SELECT p.valor FROM pagos p WHERE p.id_reserva=r.id ORDER BY p.id DESC LIMIT 1) pago_valor,
       (SELECT p.comprobante_url FROM pagos p WHERE p.id_reserva=r.id ORDER BY p.id DESC LIMIT 1) comprobante_url
       FROM reservas r JOIN clientes c ON c.id=r.id_cliente ${where}
       ORDER BY r.id DESC`,params
    );
    res.json({rows,total:rows.length});
  }catch(e){next(e)}
}

export async function pay(req,res,next){
  try{
    const r=await reservationForUser(req,req.params.id);
    if(!r)return res.status(404).json({message:'Reserva no encontrada'});
    if(r.forbidden)return res.status(403).json({message:'No tienes acceso a esta reserva'});
    if(r.estado==='cancelada')return res.status(409).json({message:'No puedes pagar una reserva cancelada'});
    if(Number(req.body.valor||0)<Number(r.anticipo))return res.status(422).json({message:'El pago debe cubrir al menos el anticipo del 50%'});
    if(!req.file)return res.status(422).json({message:'Debes adjuntar un comprobante'});
    const url=`/uploads/${req.file.filename}`;
    await query(
      'INSERT INTO pagos(id_reserva,valor,metodo_pago,comprobante_url) VALUES(?,?,?,?)',
      [r.id,req.body.valor,req.body.metodo_pago||'transferencia',url]
    );
    res.status(201).json({message:'Pago registrado y pendiente de confirmación',comprobante_url:url});
  }catch(e){next(e)}
}

export async function confirmPay(req,res,next){
  try{
    const r=await reservationForUser(req,req.params.id);
    if(!r)return res.status(404).json({message:'Reserva no encontrada'});
    if(r.forbidden)return res.status(403).json({message:'No tienes acceso a esta reserva'});
    const pending=await query('SELECT * FROM pagos WHERE id_reserva=? AND estado="pendiente" ORDER BY id DESC LIMIT 1',[r.id]);
    if(!pending[0])return res.status(409).json({message:'No hay un pago pendiente para confirmar'});
    await query('UPDATE pagos SET estado="confirmado" WHERE id=?',[pending[0].id]);
    await query('UPDATE reservas SET estado="confirmada" WHERE id=?',[r.id]);
    await sendMail({to:r.cliente_correo,subject:'Pago confirmado',text:`Tu reserva ${r.numero_confirmacion} ha sido confirmada.`});
    res.json({message:'Pago confirmado y cliente notificado'});
  }catch(e){next(e)}
}

export async function rejectPay(req,res,next){
  try{
    const r=await reservationForUser(req,req.params.id);
    if(!r)return res.status(404).json({message:'Reserva no encontrada'});
    if(r.forbidden)return res.status(403).json({message:'No tienes acceso a esta reserva'});
    const pending=await query('SELECT * FROM pagos WHERE id_reserva=? AND estado="pendiente" ORDER BY id DESC LIMIT 1',[r.id]);
    if(!pending[0])return res.status(409).json({message:'No hay un pago pendiente'});
    await query('UPDATE pagos SET estado="rechazado" WHERE id=?',[pending[0].id]);
    res.json({message:'Pago rechazado'});
  }catch(e){next(e)}
}

export async function update(req,res,next){
  try{
    const r=await reservationForUser(req,req.params.id);
    if(!r)return res.status(404).json({message:'Reserva no encontrada'});
    if(r.forbidden)return res.status(403).json({message:'No tienes acceso a esta reserva'});
    const allowed=['fecha_inicio','fecha_fin','numero_personas','notas'];
    const data=Object.fromEntries(Object.entries(req.body).filter(([k])=>allowed.includes(k)));
    if(!Object.keys(data).length)return res.status(422).json({message:'Sin cambios'});
    if(data.fecha_inicio&&data.fecha_fin&&new Date(data.fecha_fin)<=new Date(data.fecha_inicio))return res.status(422).json({message:'Rango de fechas inválido'});
    await query(`UPDATE reservas SET ${Object.keys(data).map(k=>`${k}=?`).join(',')} WHERE id=?`,[...Object.values(data),r.id]);
    res.json({message:'Reserva actualizada'});
  }catch(e){next(e)}
}

export async function cancel(req,res,next){
  try{
    const r=await reservationForUser(req,req.params.id);
    if(!r)return res.status(404).json({message:'Reserva no encontrada'});
