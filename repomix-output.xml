import { useEffect, useMemo, useState } from 'react';
import {
  apiGet,
  apiPost,
  apiPut,
  apiPatch
} from '../api/api';

import './Roles.css';

const ROLES_DISPONIBLES = [
  'Administrador',
  'Cliente'
];

const PERMISOS = [
  {
    nombre: 'ver',
    descripcion: 'Consultar información'
  },
  {
    nombre: 'crear',
    descripcion: 'Crear registros'
  },
  {
    nombre: 'editar',
    descripcion: 'Editar registros'
  },
  {
    nombre: 'eliminar',
    descripcion: 'Eliminar registros'
  },
  {
    nombre: 'exportar',
    descripcion: 'Exportar información'
  },
  {
    nombre: 'confirmar_pago',
    descripcion: 'Confirmar o rechazar pagos'
  },
  {
    nombre: 'gestionar_roles',
    descripcion: 'Gestionar roles y permisos'
  },
  {
    nombre: 'gestionar_usuarios',
    descripcion: 'Gestionar usuarios'
  },
  {
    nombre: 'gestionar_reservas',
    descripcion: 'Gestionar reservas'
  }
];

function normalizarBooleano(valor) {
  return (
    valor === true ||
    valor === 1 ||
    valor === '1' ||
    valor === 'true' ||
    valor === 'TRUE'
  );
}

function normalizarPermisos(valor) {
  if (!valor) {
    return [];
  }

  if (Array.isArray(valor)) {
    return valor;
  }

  if (typeof valor === 'string') {
    try {
      const resultado = JSON.parse(valor);

      if (Array.isArray(resultado)) {
        return resultado;
      }
    } catch {
      return valor
        .split(',')
        .map((permiso) => permiso.trim())
        .filter(Boolean);
    }
  }

  return [];
}

export default function Roles() {
  const [roles, setRoles] = useState([]);
  const [busqueda, setBusqueda] = useState('');
  const [cargando, setCargando] = useState(true);

  const [modal, setModal] = useState(null);

  const [nombre, setNombre] = useState('Cliente');
  const [permisos, setPermisos] = useState([]);
  const [estado, setEstado] = useState(true);

  const [detalle, setDetalle] = useState(null);
  const [modulos, setModulos] = useState([]);
  const [cargandoDetalle, setCargandoDetalle] =
    useState(false);

  async function cargarRoles() {
    try {
      setCargando(true);

      const respuesta = await apiGet('/roles');

      setRoles(
        Array.isArray(respuesta)
          ? respuesta
          : []
      );
    } catch (error) {
      console.error(error);

      alert(
        error?.message ||
        'No fue posible cargar los roles'
      );
    } finally {
      setCargando(false);
    }
  }

  async function cargarModulos() {
    try {
      const respuesta =
        await apiGet('/roles/modulos');

      setModulos(
        Array.isArray(respuesta)
          ? respuesta
          : []
      );
    } catch (error) {
      console.error(error);

      alert(
        error?.message ||
        'No fue posible cargar los módulos'
      );
    }
  }

  async function cargarDetalle(id) {
    try {
      setCargandoDetalle(true);
      setDetalle(null);

      const respuesta =
        await apiGet(`/roles/${id}`);

      setDetalle(respuesta);
    } catch (error) {
      console.error(error);

      alert(
        error?.message ||
        'No fue posible cargar el detalle del rol'
      );

      setModal(null);
    } finally {
      setCargandoDetalle(false);
    }
  }

  useEffect(() => {
    cargarRoles();
  }, []);

  function abrirCrear() {
    setNombre('Cliente');
    setPermisos(['ver']);
    setEstado(true);
    setModal('crear');
  }

  function abrirEditar(rol) {
    setNombre(
      ROLES_DISPONIBLES.includes(
        rol.nombre_rol
      )
        ? rol.nombre_rol
        : 'Cliente'
    );

    setPermisos(
      normalizarPermisos(
        rol.permisos_lista ?? rol.permisos
      )
    );

    setEstado(
      normalizarBooleano(
        rol.estado_rol
      )
    );

    setModal({
      tipo: 'editar',
      id: rol.id
    });
  }

  function cambiarPermiso(nombrePermiso) {
    setPermisos((actuales) => {
      if (actuales.includes(nombrePermiso)) {
        return actuales.filter(
          (permiso) =>
            permiso !== nombrePermiso
        );
      }

      return [
        ...actuales,
        nombrePermiso
      ];
    });
  }

  async function crear() {
    if (!nombre) {
      alert(
        'Debes seleccionar un nombre de rol'
      );
      return;
    }

    const confirmar = window.confirm(
      `¿Deseas crear el rol "${nombre}"?`
    );

    if (!confirmar) {
      return;
    }

    try {
      await apiPost('/roles', {
        nombre_rol: nombre,
        permisos,
        estado_rol: estado
      });

      setModal(null);

      await cargarRoles();

      alert(
        'Rol creado correctamente'
      );
    } catch (error) {
      console.error(error);

      alert(
        error?.message ||
        'No fue posible crear el rol'
      );
    }
  }

  async function guardarEdicion() {
    if (!modal?.id) {
      return;
    }

    if (!nombre) {
      alert(
        'Debes seleccionar un nombre de rol'
      );
      return;
    }

    const confirmar = window.confirm(
      `¿Guardar los cambios del rol "${nombre}"?`
    );

    if (!confirmar) {
      return;
    }

    try {
      await apiPut(
        `/roles/${modal.id}`,
        {
          nombre_rol: nombre,
          permisos,
          estado_rol: estado
        }
      );

      setModal(null);

      await cargarRoles();

      alert(
        'Rol actualizado correctamente'
      );
    } catch (error) {
      console.error(error);

      alert(
        error?.message ||
        'No fue posible actualizar el rol'
      );
    }
  }

  async function cambiarEstado(rol) {
    const nuevoEstado =
      !normalizarBooleano(
        rol.estado_rol
      );

    const confirmar = window.confirm(
      nuevoEstado
        ? `¿Activar el rol "${rol.nombre_rol}"?`
        : `¿Desactivar el rol "${rol.nombre_rol}"?`
    );

    if (!confirmar) {
      return;
    }

    try {
      await apiPatch(
        `/roles/${rol.id}/estado`,
        {
          estado_rol: nuevoEstado
        }
      );

      await cargarRoles();
    } catch (error) {
      console.error(error);

      alert(
        error?.message ||
        'No fue posible cambiar el estado'
      );
    }
  }

  async function cambiarModulo(
    modulo,
    activo
  ) {
    if (!detalle?.rol) {
      return;
    }

    const confirmar = window.confirm(
      activo
        ? `¿Asignar el módulo "${modulo.nombre_modulo}" al rol "${detalle.rol.nombre_rol}"?`
        : `¿Desactivar el módulo "${modulo.nombre_modulo}" para este rol?`
    );

    if (!confirmar) {
      return;
    }

    try {
      await apiPatch(
        `/roles/${detalle.rol.id}/modulos/${modulo.id}`,
        {
          estado_permiso: activo
        }
      );

      await cargarDetalle(
        detalle.rol.id
      );

      await cargarRoles();
    } catch (error) {
      console.error(error);

      alert(
        error?.message ||
        'No fue posible actualizar el módulo'
      );
    }
  }

  async function abrirDetalle(rol) {
    setModal('detalle');

    await Promise.all([
      cargarDetalle(rol.id),
      cargarModulos()
    ]);
  }

  const rolesFiltrados = useMemo(() => {
    const texto =
      busqueda
        .trim()
        .toLowerCase();

    if (!texto) {
      return roles;
    }

    return roles.filter((rol) =>
      String(
        rol.nombre_rol || ''
      )
        .toLowerCase()
        .includes(texto)
    );
  }, [roles, busqueda]);

  return (
    <div className="roles-page">

      <div className="roles-header">

        <div>
          <div className="roles-kicker">
            ADMINISTRACIÓN
          </div>

          <h1>Roles</h1>

          <p>
            Gestiona roles, permisos, estados
            y módulos asociados.
          </p>
        </div>

        <button
          className="roles-primary"
          onClick={abrirCrear}
        >
          + Crear rol
        </button>

      </div>

      <div className="roles-toolbar">

        <input
          type="text"
          placeholder="Buscar rol..."
          value={busqueda}
          onChange={(event) =>
            setBusqueda(
              event.target.value
            )
          }
        />

        <span>
          {rolesFiltrados.length} rol(es)
        </span>

      </div>

      <div className="roles-table-container">

        {cargando ? (
          <div className="roles-empty">
            Cargando roles...
          </div>
        ) : rolesFiltrados.length === 0 ? (
          <div className="roles-empty">
            No se encontraron roles.
          </div>
        ) : (
          <table className="roles-table">

            <thead>
              <tr>
                <th>Nombre</th>
                <th>Permisos</th>
                <th>Usuarios</th>
                <th>Módulos</th>
                <th>Estado</th>
                <th>Acciones</th>
              </tr>
            </thead>

            <tbody>

              {rolesFiltrados.map((rol) => {

                const activo =
                  normalizarBooleano(
                    rol.estado_rol
                  );

                const permisosRol =
                  normalizarPermisos(
                    rol.permisos_lista ??
                    rol.permisos
                  );

                return (
                  <tr key={rol.id}>

                    <td>
                      <strong>
                        {rol.nombre_rol}
                      </strong>
                    </td>

                    <td>
                      <span className="roles-count">
                        {permisosRol.length}
                      </span>
                    </td>

                    <td>
                      {rol.usuarios_asignados ?? 0}
                    </td>

                    <td>
                      {rol.modulos_asignados ?? 0}
                    </td>

                    <td>

                      <select
                        className={
                          activo
                            ? 'roles-status-select active'
                            : 'roles-status-select inactive'
                        }
                        value={
                          activo
                            ? 'activo'
                            : 'inactivo'
                        }
                        onChange={(event) =>
                          cambiarEstado(
                            rol
                          )
                        }
                      >
                        <option value="activo">
                          Activo
                        </option>

                        <option value="inactivo">
                          Inactivo
                        </option>
                      </select>

                    </td>

                    <td>

                      <div className="roles-actions">

                        <button
                          onClick={() =>
                            abrirDetalle(
                              rol
                            )
                          }
                        >
                          Ver
                        </button>

                        <button
                          onClick={() =>
                            abrirEditar(
                              rol
                            )
                          }
                        >
                          Editar
                        </button>

                      </div>

                    </td>

                  </tr>
                );
              })}

            </tbody>

          </table>
        )}

      </div>

      {/* CREAR */}

      {modal === 'crear' && (
        <div className="roles-modal-backdrop">

          <div className="roles-modal">

            <div className="roles-modal-header">

              <div>
                <span>ROLES</span>
                <h2>
                  Crear rol
                </h2>
              </div>

              <button
                onClick={() =>
                  setModal(null)
                }
              >
                ×
              </button>

            </div>

            <label>
              Nombre del rol
            </label>

            <select
              value={nombre}
              onChange={(event) =>
                setNombre(
                  event.target.value
                )
              }
            >
              {ROLES_DISPONIBLES.map(
                (rol) => (
                  <option
                    key={rol}
                    value={rol}
                  >
                    {rol}
                  </option>
                )
              )}
            </select>

            <label>
              Estado
            </label>

            <select
              value={
                estado
                  ? 'activo'
                  : 'inactivo'
              }
              onChange={(event) =>
                setEstado(
                  event.target.value ===
                  'activo'
                )
              }
            >
              <option value="activo">
                Activo
              </option>

              <option value="inactivo">
                Inactivo
              </option>
            </select>

            <label>
              Permisos
            </label>

            <div className="roles-permissions">

              {PERMISOS.map(
                (permiso) => {

                  const seleccionado =
                    permisos.includes(
                      permiso.nombre
                    );

                  return (
                    <label
                      key={
                        permiso.nombre
                      }
                      className={
                        seleccionado
                          ? 'roles-permission selected'
                          : 'roles-permission'
                      }
                    >

                      <input
                        type="checkbox"
                        checked={
                          seleccionado
                        }
                        onChange={() =>
                          cambiarPermiso(
                            permiso.nombre
                          )
                        }
                      />

                      <span>
                        <strong>
                          {permiso.nombre}
                        </strong>

                        <small>
                          {permiso.descripcion}
                        </small>
                      </span>

                    </label>
                  );
                }
              )}

            </div>

            <div className="roles-modal-buttons">

              <button
                className="roles-secondary"
                onClick={() =>
                  setModal(null)
                }
              >
                Cancelar
              </button>

              <button
                className="roles-primary"
                onClick={crear}
              >
                Crear rol
              </button>

            </div>

          </div>

        </div>
      )}

      {/* EDITAR */}

      {modal?.tipo === 'editar' && (
        <div className="roles-modal-backdrop">

          <div className="roles-modal">

            <div className="roles-modal-header">

              <div>
                <span>ROLES</span>

                <h2>
                  Editar rol
                </h2>
              </div>

              <button
                onClick={() =>
                  setModal(null)
                }
              >
                ×
              </button>

            </div>

            <label>
              Nombre del rol
            </label>

            <select
              value={nombre}
              onChange={(event) =>
                setNombre(
                  event.target.value
                )
              }
            >
              {ROLES_DISPONIBLES.map(
                (rol) => (
                  <option
                    key={rol}
                    value={rol}
                  >
                    {rol}
                  </option>
                )
              )}
            </select>

            <label>
              Estado
            </label>

            <select
              value={
                estado
                  ? 'activo'
                  : 'inactivo'
              }
              onChange={(event) =>
                setEstado(
                  event.target.value ===
                  'activo'
                )
              }
            >
              <option value="activo">
                Activo
              </option>

              <option value="inactivo">
                Inactivo
              </option>
            </select>

            <label>
              Permisos
            </label>

            <div className="roles-permissions">

              {PERMISOS.map(
                (permiso) => {

                  const seleccionado =
                    permisos.includes(
                      permiso.nombre
                    );

                  return (
                    <label
                      key={
                        permiso.nombre
                      }
                      className={
                        seleccionado
                          ? 'roles-permission selected'
                          : 'roles-permission'
                      }
                    >

                      <input
                        type="checkbox"
                        checked={
                          seleccionado
                        }
                        onChange={() =>
                          cambiarPermiso(
                            permiso.nombre
                          )
                        }
                      />

                      <span>
                        <strong>
                          {permiso.nombre}
                        </strong>

                        <small>
                          {permiso.descripcion}
                        </small>
                      </span>

                    </label>
                  );
                }
              )}

            </div>

            <div className="roles-modal-buttons">

              <button
                className="roles-secondary"
                onClick={() =>
                  setModal(null)
                }
              >
                Cancelar
              </button>

              <button
                className="roles-primary"
                onClick={guardarEdicion}
              >
                Guardar cambios
              </button>

            </div>

          </div>

        </div>
      )}

      {/* DETALLE */}

      {modal === 'detalle' && (
        <div className="roles-modal-backdrop">

          <div className="roles-modal roles-modal-large">

            <div className="roles-modal-header">

              <div>

                <span>
                  DETALLE DEL ROL
                </span>

                <h2>
                  {detalle?.rol?.nombre_rol ||
                    'Cargando...'}
                </h2>

              </div>

              <button
                onClick={() =>
                  setModal(null)
                }
              >
                ×
              </button>

            </div>

            {cargandoDetalle ||
            !detalle ? (
              <div className="roles-empty">
                Cargando información...
              </div>
            ) : (
              <>

                <div className="roles-detail-grid">

                  <div>
                    <span>
                      Estado
                    </span>

                    <strong
                      className={
                        detalle.rol.estado_rol
                          ? 'roles-detail-active'
                          : 'roles-detail-inactive'
                      }
                    >
                      {detalle.rol.estado_rol
                        ? 'Activo'
                        : 'Inactivo'}
                    </strong>
                  </div>

                  <div>
                    <span>
                      Usuarios
                    </span>

                    <strong>
                      {detalle.usuarios
                        ?.length || 0}
                    </strong>
                  </div>

                  <div>
                    <span>
                      Módulos
                    </span>

                    <strong>
                      {
                        detalle.modulos?.filter(
                          (modulo) =>
                            normalizarBooleano(
                              modulo.estado_permiso
                            )
                        ).length
                      }
                    </strong>
                  </div>

                  <div>
                    <span>
                      Creado
                    </span>

                    <strong>
                      {detalle.rol.created_at
                        ? new Date(
                            detalle.rol.created_at
                          ).toLocaleDateString(
                            'es-CO'
                          )
                        : '—'}
                    </strong>
                  </div>

                  <div>
                    <span>
                      Permisos
                    </span>

                    <strong>
                      {
                        normalizarPermisos(
                          detalle.rol
                            .permisos_lista ??
                          detalle.rol.permisos
                        ).length
                      }
                    </strong>
                  </div>

                </div>

                <h3 className="roles-subtitle">
                  Permisos del rol
                </h3>

                <div className="roles-permission-detail">

                  {PERMISOS.map(
                    (permiso) => {

                      const activos =
                        normalizarPermisos(
                          detalle.rol
                            .permisos_lista ??
                          detalle.rol.permisos
                        );

                      const activo =
                        activos.includes(
                          permiso.nombre
                        );

                      return (
                        <div
                          key={
                            permiso.nombre
                          }
                          className={
                            activo
                              ? 'roles-permission-detail-item active'
                              : 'roles-permission-detail-item'
                          }
                        >
                          <strong>
                            {permiso.nombre}
                          </strong>

                          <span>
                            {permiso.descripcion}
                          </span>

                          <b>
                            {activo
                              ? 'Asignado'
                              : 'No asignado'}
                          </b>
                        </div>
                      );
                    }
                  )}

                </div>

                <h3 className="roles-subtitle">
                  Módulos asociados
                </h3>

                <div className="roles-module-list">

                  {modulos.map(
                    (modulo) => {

                      const asignado =
                        detalle.modulos?.find(
                          (item) =>
                            Number(
                              item.id
                            ) ===
                            Number(
                              modulo.id
                            )
                        );

                      const activo =
                        normalizarBooleano(
                          asignado?.estado_permiso
                        );

                      return (
                        <label
                          key={
                            modulo.id
                          }
                          className={
                            activo
                              ? 'roles-module active'
                              : 'roles-module'
                          }
                        >

                          <input
                            type="checkbox"
                            checked={activo}
                            onChange={(event) =>
                              cambiarModulo(
                                modulo,
                                event.target.checked
                              )
                            }
                          />

                          <span>
                            {
                              modulo.nombre_modulo
                            }
                          </span>

                        </label>
                      );
                    }
                  )}

                </div>

                <h3 className="roles-subtitle">
                  Usuarios asignados
                </h3>

                <div className="roles-users">

                  {!detalle.usuarios
                    ?.length ? (
                    <p>
                      No hay usuarios
                      asignados.
                    </p>
                  ) : (
                    detalle.usuarios.map(
                      (usuario) => (
                        <div
                          key={
                            usuario.id
                          }
                        >

                          <strong>
                            {
                              usuario.nombre_usuario
                            }
                          </strong>

                          <span>
                            {usuario.correo}
                          </span>

                        </div>
                      )
                    )
                  )}

                </div>

              </>
            )}

          </div>

        </div>
      )}

    </div>
  );
}
