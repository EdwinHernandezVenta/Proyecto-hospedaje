              </span>

              <input
                type="text"
                name="nombre"
                value={form.nombre}
                onChange={cambiarCampo}
                placeholder="Tu nombre"
                maxLength={50}
                autoComplete="given-name"
                required
              />
            </label>

            <label>
              <span>
                Apellido *
              </span>

              <input
                type="text"
                name="apellido"
                value={form.apellido}
