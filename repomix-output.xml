  fileFilter: (req, file, cb) => {

    const permitidos = [
      'application/pdf',
      'image/jpeg',
      'image/png'
    ];

    const permitido =
      permitidos.includes(file.mimetype);

    cb(
      permitido
        ? null
        : new Error(
            'Solo se permiten comprobantes PDF, JPG o PNG'
          ),
      permitido
    );
  }
});


/* =========================================================
   ADMINISTRADOR
