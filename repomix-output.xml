import { useEffect,useMemo,useState } from 'react';
import { api } from '../api/http';
import { useAuth } from '../context/AuthContext';

const money=n=>`$${Number(n||0).toLocaleString('es-CO')}`;

function Badge({value}){
  const v=String(value||'').toLowerCase();
  const cls=v.includes('confirm')||v==='confirmado'?'ok':v.includes('cancel')||v==='rechazado'?'danger':v.includes('pend')?'pending':'info';
  return <span className={`badge ${cls}`}>{value||'—'}</span>
}

export default function Reservas(){
  const {user}=useAuth();
  const isAdmin=user?.rol==='Administrador';
  const [rows,setRows]=useState([]);
  const [clientes,setClientes]=useState([]);
  const [habitaciones,setHabitaciones]=useState([]);
  const [msg,setMsg]=useState('');
  const [loading,setLoading]=useState(false);
  const [fileById,setFileById]=useState({});
  const [payById,setPayById]=useState({});
  const [f,setF]=useState({id_cliente:'',id_habitacion:'',fecha_inicio:'',fecha_fin:'',numero_personas:1,valor_total:0,notas:''});

  async function load(){
    setLoading(true);
    try{const x=await api.get('/reservas');setRows(x.data.rows||[])}
    catch(x){setMsg(x.response?.data?.message||'No se pudieron cargar las reservas')}
    finally{setLoading(false)}
  }

  async function loadCatalogs(){
    try{
      const h=await api.get('/habitaciones');
      setHabitaciones(h.data.rows||[]);
      if(isAdmin){
        const c=await api.get('/clientes');
        setClientes(c.data.rows||[]);
      }
    }catch(x){setMsg(x.response?.data?.message||'No se pudieron cargar los catálogos')}
  }

  useEffect(()=>{load();loadCatalogs()},[isAdmin]);

  const selectedRoom=useMemo(
    ()=>habitaciones.find(x=>String(x.id)===String(f.id_habitacion)),
    [habitaciones,f.id_habitacion]
  );

  useEffect(()=>{
    if(!selectedRoom||!f.fecha_inicio||!f.fecha_fin)return;
    const start=new Date(f.fecha_inicio),end=new Date(f.fecha_fin);
    const ms=end-start;
    if(ms>0){
      const nights=Math.max(1,Math.ceil(ms/86400000));
      setF(prev=>({...prev,valor_total:Number(selectedRoom.tarifa)*nights}));
    }
  },[selectedRoom,f.fecha_inicio,f.fecha_fin]);

  async function crear(e){
    e.preventDefault();setMsg('');
    try{
      const total=Number(f.valor_total);
      if(isAdmin&&!f.id_cliente) return setMsg('Selecciona un cliente.');
      if(!f.id_habitacion) return setMsg('Selecciona una habitación.');
      if(!f.fecha_inicio||!f.fecha_fin) return setMsg('Selecciona las fechas.');
      if(new Date(f.fecha_fin)<=new Date(f.fecha_inicio)) return setMsg('La fecha de salida debe ser posterior a la entrada.');
      if(total<=0) return setMsg('El valor total debe ser mayor que 0.');

      await api.post('/reservas',{
        id_cliente:isAdmin?Number(f.id_cliente):undefined,
        fecha_inicio:f.fecha_inicio,
        fecha_fin:f.fecha_fin,
        numero_personas:Number(f.numero_personas),
        valor_total:total,
        anticipo:total/2,
        notas:f.notas,
        detalles:[{id_habitacion:Number(f.id_habitacion),cantidad:1,subtotal:total}]
      });
      setMsg('✓ Reserva creada correctamente.');
      setF({id_cliente:'',id_habitacion:'',fecha_inicio:'',fecha_fin:'',numero_personas:1,valor_total:0,notas:''});
      await load();
    }catch(x){setMsg(x.response?.data?.message||'No se pudo crear la reserva.')}
  }

  async function subirPago(r){
    try{
      const file=fileById[r.id];
      if(!file) return setMsg('Selecciona primero el comprobante.');
      const valor=Number(payById[r.id]||r.anticipo);
      const fd=new FormData();
      fd.append('valor',String(valor));
      fd.append('metodo_pago','transferencia');
      fd.append('comprobante',file);
      await api.post(`/reservas/${r.id}/pago`,fd,{headers:{'Content-Type':'multipart/form-data'}});
      setMsg('✓ Comprobante enviado. Queda pendiente de revisión.');
      setFileById({...fileById,[r.id]:null});
      await load();
    }catch(x){setMsg(x.response?.data?.message||'No se pudo registrar el pago.')}
  }

  async function confirmar(id){
    try{await api.patch(`/reservas/${id}/confirmar-pago`);setMsg('✓ Pago confirmado y reserva actualizada.');await load()}
    catch(x){setMsg(x.response?.data?.message||'No se pudo confirmar el pago.')}
  }

  async function cancelar(id){
    if(!confirm('¿Cancelar esta reserva?'))return;
    try{await api.patch(`/reservas/${id}/cancelar`);setMsg('Reserva cancelada.');await load()}
    catch(x){setMsg(x.response?.data?.message||'No se pudo cancelar')}
  }

  return (
    <section>
      <div className="page-title">
        <h1>{isAdmin?'Reservas':'Mis reservas'}</h1>
        <p>Gestiona disponibilidad, reservas y el anticipo del 50%.</p>
      </div>

      <div className="card">
        <div className="title"><h3>Nueva reserva</h3><span style={{color:'var(--muted)',fontSize:12}}>El total se calcula según noches × tarifa.</span></div>
        <form className="form" onSubmit={crear}>
          {isAdmin&&<div className="field"><label>CLIENTE</label><select value={f.id_cliente} onChange={e=>setF({...f,id_cliente:e.target.value})}><option value="">Seleccionar cliente</option>{clientes.map(c=><option key={c.id} value={c.id}>{c.nombre} {c.apellido} — {c.correo}</option>)}</select></div>}
          <div className="field"><label>HABITACIÓN</label><select value={f.id_habitacion} onChange={e=>setF({...f,id_habitacion:e.target.value})}><option value="">Seleccionar habitación</option>{habitaciones.filter(h=>h.estado==='disponible').map(h=><option key={h.id} value={h.id}>#{h.numero_habitacion} · {h.tipo_habitacion} · {money(h.tarifa)}/noche</option>)}</select></div>
          <div className="field"><label>ENTRADA</label><input type="datetime-local" value={f.fecha_inicio} onChange={e=>setF({...f,fecha_inicio:e.target.value})}/></div>
          <div className="field"><label>SALIDA</label><input type="datetime-local" value={f.fecha_fin} onChange={e=>setF({...f,fecha_fin:e.target.value})}/></div>
          <div className="field"><label>PERSONAS</label><input type="number" min="1" value={f.numero_personas} onChange={e=>setF({...f,numero_personas:e.target.value})}/></div>
          <div className="field"><label>VALOR TOTAL</label><input type="number" min="1" value={f.valor_total} onChange={e=>setF({...f,valor_total:e.target.value})}/></div>
          <div className="field"><label>NOTAS</label><input value={f.notas} onChange={e=>setF({...f,notas:e.target.value})} placeholder="Solicitud especial…"/></div>
          <div className="card" style={{padding:14,margin:0}}>
            <small style={{color:'var(--muted)'}}>ANTICIPO REQUERIDO</small>
            <div style={{fontFamily:'Space Grotesk',fontSize:24,fontWeight:700}}>{money(Number(f.valor_total)/2)}</div>
          </div>
          <div className="form-actions"><button className="primary">Crear reserva →</button></div>
        </form>
      </div>

      {msg&&<div className="notice">{msg}</div>}

      <div className="card">
        <div className="title"><h3>Historial</h3><span style={{color:'var(--muted)',fontSize:12}}>{loading?'Actualizando…':`${rows.length} reservas`}</span></div>
        <div className="tablewrap">
          <table>
            <thead><tr><th>Confirmación</th><th>Cliente</th><th>Entrada</th><th>Salida</th><th>Total</th><th>Anticipo</th><th>Reserva</th><th>Pago</th><th>Acciones</th></tr></thead>
            <tbody>
              {rows.map(r=><tr key={r.id}>
                <td><b>{r.numero_confirmacion}</b></td>
                <td>{r.cliente}</td>
                <td>{r.fecha_inicio}</td>
                <td>{r.fecha_fin}</td>
                <td>{money(r.valor_total)}</td>
                <td>{money(r.anticipo)}</td>
                <td><Badge value={r.estado}/></td>
                <td><Badge value={r.pago_estado||'sin pago'}/></td>
                <td>
                  <div className="reservation-actions">
                    {r.estado!=='cancelada' && r.pago_estado!=='confirmado' && (
                      <>
                        <input className="file-input" type="file" accept=".pdf,.jpg,.jpeg,.png" onChange={e=>setFileById({...fileById,[r.id]:e.target.files?.[0]})}/>
                        <input style={{width:120}} type="number" min={r.anticipo} value={payById[r.id]??r.anticipo} onChange={e=>setPayById({...payById,[r.id]:e.target.value})}/>
                        <button className="primary" onClick={()=>subirPago(r)}>Subir comprobante</button>
                      </>
                    )}
                    {isAdmin && r.pago_estado==='pendiente' && <button className="primary" onClick={()=>confirmar(r.id)}>✓ Confirmar pago</button>}
                    {r.estado!=='cancelada' && r.estado!=='check-out' && <button className="secondary danger" onClick={()=>cancelar(r.id)}>Cancelar</button>}
                  </div>
                </td>
              </tr>)}
            </tbody>
          </table>
          {!rows.length&&<div className="empty">Todavía no hay reservas.</div>}
        </div>
      </div>
    </section>
  );
}
</file>

