import { query } from '../config/db.js';
import {
  list,
  safeTables,
  tableColumns
} from '../repositories/genericRepository.js';
import bcrypt from 'bcryptjs';


/* =========================================================
   PERMISOS VÁLIDOS
========================================================= */

const PERMISOS_VALIDOS = [
  'ver',
  'crear',
  'editar',
  'eliminar',
  'exportar',
  'confirmar_pago',
  'gestionar_roles',
  'gestionar_usuarios',
  'gestionar_reservas'
];


/* =========================================================
   TABLAS ADMINISTRATIVAS
========================================================= */

const TABLAS_ADMIN = new Set([
  'roles',
  'usuarios',
  'clientes'
]);


/* =========================================================
   MÓDULOS QUE EL CLIENTE PUEDE CONSULTAR
========================================================= */

const MODULOS_CLIENTE = new Set([
  'habitaciones',
  'servicios',
  'paquetes',
  'huespedes',
  'feedback'
]);


/* =========================================================
   MÓDULOS EN LOS QUE EL CLIENTE PUEDE CREAR
========================================================= */

const CLIENTE_PUEDE_CREAR = new Set([
  'huespedes',
  'feedback'
]);


/* =========================================================
   MÓDULOS EN LOS QUE EL CLIENTE PUEDE EDITAR
========================================================= */

const CLIENTE_PUEDE_EDITAR = new Set([
  'huespedes',
  'feedback'
]);


/* =========================================================
   OBTENER PERMISOS DEL ROL
========================================================= */

async function obtenerPermisosUsuario(req) {

  if (!req.user) {
    return [];
  }

  const rows = await query(
    `
      SELECT permisos
      FROM roles
      WHERE nombre_rol = ?
      LIMIT 1
    `,
    [req.user.rol]
  );

  if (!rows[0]) {
    return [];
  }

  const permisos = rows[0].permisos;

  if (!permisos) {
    return [];
  }

  if (Array.isArray(permisos)) {

    return permisos.filter(
      permiso =>
        PERMISOS_VALIDOS.includes(permiso)
    );
  }

  if (typeof permisos === 'string') {

    try {

      const parsed =
        JSON.parse(permisos);

      if (Array.isArray(parsed)) {

        return parsed.filter(
          permiso =>
            PERMISOS_VALIDOS.includes(permiso)
        );
      }

    } catch {

      return permisos
        .split(',')
        .map(
          permiso =>
            permiso.trim()
        )
        .filter(
          permiso =>
            PERMISOS_VALIDOS.includes(permiso)
        );
    }
  }

  return [];
}


/* =========================================================
   COMPROBAR PERMISO
========================================================= */

async function tienePermiso(
  req,
  permiso
) {

  /*
    Administrador:

    Si el Administrador está activo,
    se le permite la operación.
  */

  if (
    req.user?.rol === 'Administrador'
  ) {
    return true;
  }

  const permisos =
    await obtenerPermisosUsuario(req);

  return permisos.includes(permiso);
}


/* =========================================================
   RESPUESTA SIN PERMISO
========================================================= */

function accesoDenegado(
  res,
  permiso
) {

  return res.status(403).json({
    message:
      `No tienes permiso para realizar esta acción: ${permiso}`
  });
}


/* =========================================================
   LIMPIAR DATOS
========================================================= */

function cleanData(
  table,
  data
) {

  const allowed =
    tableColumns[table] ||
    new Set();

  return Object.fromEntries(
    Object.entries(data).filter(
      ([key, value]) =>
        allowed.has(key) &&
        key !== 'id' &&
        key !== 'created_at' &&
        key !== 'updated_at' &&
        value !== ''
    )
  );
}


/* =========================================================
   OBTENER ID DEL CLIENTE ACTUAL
========================================================= */

async function obtenerIdCliente(req) {

  if (!req.user) {
    return null;
  }

  const rows =
    await query(
      `
        SELECT id
        FROM clientes
        WHERE correo = ?
        LIMIT 1
      `,
      [req.user.correo]
    );

  return rows[0]?.id || null;
}


/* =========================================================
   COMPROBAR PROPIEDAD
========================================================= */

async function comprobarPropiedadCliente(
  req,
  table,
  id
) {

  if (
    req.user?.rol !== 'Cliente'
  ) {
    return true;
  }


  const idCliente =
    await obtenerIdCliente(req);


  if (!idCliente) {
    return false;
  }


  /* =======================================================
     FEEDBACK
  ======================================================= */

  if (
    table === 'encuestas_feedback'
  ) {

    const rows =
      await query(
        `
          SELECT id
          FROM encuestas_feedback
          WHERE id = ?
            AND id_cliente = ?
          LIMIT 1
        `,
        [
          id,
          idCliente
        ]
      );

    return Boolean(rows[0]);
  }


  /* =======================================================
     HUÉSPEDES
  ======================================================= */

  if (
    table === 'huespedes'
  ) {

    const rows =
      await query(
        `
          SELECT h.id
          FROM huespedes h
          INNER JOIN reservas r
            ON r.id = h.id_reserva
          WHERE h.id = ?
            AND r.id_cliente = ?
          LIMIT 1
        `,
        [
          id,
          idCliente
        ]
      );

    return Boolean(rows[0]);
  }


  return false;
}


/* =========================================================
   COMPROBAR RESERVA DEL CLIENTE
========================================================= */

async function comprobarReservaCliente(
  req,
  idReserva
) {

  if (
    req.user?.rol !== 'Cliente'
  ) {
    return true;
  }

  const idCliente =
    await obtenerIdCliente(req);

  if (!idCliente) {
    return false;
  }

  const rows =
    await query(
      `
        SELECT id
        FROM reservas
        WHERE id = ?
          AND id_cliente = ?
        LIMIT 1
      `,
      [
        idReserva,
        idCliente
      ]
    );

  return Boolean(rows[0]);
}


/* =========================================================
   LISTAR
========================================================= */

export const genericList =
  table => async (
    req,
    res,
    next
  ) => {

    try {

      if (
        !safeTables.has(table)
      ) {
        return res.status(400).json({
          message:
            'Tabla no permitida'
        });
      }


      /*
        Todo usuario autenticado
        necesita permiso "ver".
      */

      const puedeVer =
        await tienePermiso(
          req,
          'ver'
        );

      if (!puedeVer) {
        return accesoDenegado(
          res,
          'ver'
        );
      }


      /*
        Cliente no puede entrar
        a tablas administrativas.
      */

      if (
        req.user?.rol === 'Cliente' &&
        TABLAS_ADMIN.has(table)
      ) {

        return res.status(403).json({
          message:
            'Los clientes no pueden acceder a este módulo'
        });
      }


      /*
        Cliente solamente puede
        consultar los módulos permitidos.
      */

      if (
        req.user?.rol === 'Cliente' &&
        !MODULOS_CLIENTE.has(table)
      ) {

        return res.status(403).json({
          message:
            'No tienes acceso a este módulo'
        });
      }


      /*
        HUESPEDES:

        El cliente solamente recibe
        huéspedes relacionados con
        sus propias reservas.
      */

      if (
        req.user?.rol === 'Cliente' &&
        table === 'huespedes'
      ) {

        const idCliente =
          await obtenerIdCliente(req);

        if (!idCliente) {

          return res.status(403).json({
            message:
              'No se encontró el cliente asociado a tu usuario'
          });
        }


        const search =
          req.query.search || '';

        const limit =
          Math.min(
            Number(req.query.limit) || 50,
            100
          );


        const rows =
          await query(
            `
              SELECT h.*
              FROM huespedes h
              INNER JOIN reservas r
                ON r.id = h.id_reserva
              WHERE r.id_cliente = ?
                AND (
                  h.documento LIKE ?
                  OR h.nombres LIKE ?
                  OR h.apellidos LIKE ?
                  OR h.correo LIKE ?
                )
              ORDER BY h.id DESC
              LIMIT ${limit}
            `,
            [
              idCliente,
              `%${search}%`,
              `%${search}%`,
              `%${search}%`,
              `%${search}%`
            ]
          );


        return res.json({
          rows,
          total: rows.length
        });
      }


      /*
        FEEDBACK:

        El cliente solamente recibe
        sus propios comentarios.
      */

      if (
        req.user?.rol === 'Cliente' &&
        table === 'encuestas_feedback'
      ) {

        const idCliente =
          await obtenerIdCliente(req);

        if (!idCliente) {

          return res.status(403).json({
            message:
              'No se encontró el cliente asociado a tu usuario'
          });
        }


        const search =
          req.query.search || '';

        const limit =
          Math.min(
            Number(req.query.limit) || 50,
            100
          );


        const rows =
          await query(
            `
              SELECT f.*
              FROM encuestas_feedback f
              WHERE f.id_cliente = ?
                AND (
                  f.comentario LIKE ?
                  OR CAST(f.calificacion AS CHAR) LIKE ?
                )
              ORDER BY f.id DESC
              LIMIT ${limit}
            `,
            [
              idCliente,
              `%${search}%`,
              `%${search}%`
            ]
          );


        return res.json({
          rows,
          total: rows.length
        });
      }


      /*
        Los demás módulos utilizan
        el repositorio general.
      */

      return res.json(
        await list(
          table,
          req.query
        )
      );

    } catch (e) {

      next(e);
    }
  };


/* =========================================================
   OBTENER UNO
========================================================= */

export const genericGet =
  table => async (
    req,
    res,
    next
  ) => {

    try {

      if (
        !safeTables.has(table)
      ) {

        return res.status(400).json({
          message:
            'Tabla no permitida'
        });
      }


      const puedeVer =
        await tienePermiso(
          req,
          'ver'
        );

      if (!puedeVer) {

        return accesoDenegado(
          res,
          'ver'
        );
      }


      if (
        req.user?.rol === 'Cliente' &&
        TABLAS_ADMIN.has(table)
      ) {

        return res.status(403).json({
          message:
            'Los clientes no pueden acceder a este módulo'
        });
      }


      if (
        req.user?.rol === 'Cliente' &&
        !MODULOS_CLIENTE.has(table)
      ) {

        return res.status(403).json({
          message:
            'No tienes acceso a este módulo'
        });
      }


      const rows =
        await query(
          `SELECT * FROM ${table} WHERE id = ?`,
          [req.params.id]
        );


      if (!rows[0]) {

        return res.status(404).json({
          message:
            'Registro no encontrado'
        });
      }


      /*
        El Cliente solamente puede
        consultar sus propios huéspedes
        y feedback.
      */

      if (
        req.user?.rol === 'Cliente' &&
        (
          table === 'huespedes' ||
          table === 'encuestas_feedback'
        )
      ) {

        const propietario =
          await comprobarPropiedadCliente(
            req,
            table,
            req.params.id
          );

        if (!propietario) {

          return res.status(403).json({
            message:
              'No puedes acceder a este registro'
          });
        }
      }


      return res.json(
        rows[0]
      );

    } catch (e) {

      next(e);
    }
  };


/* =========================================================
   CREAR
========================================================= */

export const genericCreate =
  table => async (
    req,
    res,
    next
  ) => {

    try {

      if (
        !safeTables.has(table)
      ) {

        return res.status(400).json({
          message:
            'Tabla no permitida'
        });
      }


      const puedeCrear =
        await tienePermiso(
          req,
          'crear'
        );

      if (!puedeCrear) {

        return accesoDenegado(
          res,
          'crear'
        );
      }


      /*
        ADMINISTRADOR

        Puede crear registros.
      */

      if (
        req.user?.rol === 'Cliente'
      ) {

        /*
          No puede crear tablas
          administrativas.
        */

        if (
          TABLAS_ADMIN.has(table)
        ) {

          return res.status(403).json({
            message:
              'No puedes crear registros en este módulo'
          });
        }


        /*
          Solamente puede crear
          huéspedes y feedback.
        */

        if (
          !CLIENTE_PUEDE_CREAR.has(table)
        ) {

          return res.status(403).json({
            message:
              'No tienes permiso para crear registros en este módulo'
          });
        }
      }


      const data =
        cleanData(
          table,
          req.body
        );


      /* ===================================================
         FEEDBACK
      =================================================== */

      if (
        req.user?.rol === 'Cliente' &&
        table === 'encuestas_feedback'
      ) {

        const idCliente =
          await obtenerIdCliente(req);

        if (!idCliente) {

          return res.status(403).json({
            message:
              'No se encontró el cliente asociado a tu usuario'
          });
        }


        /*
          El cliente no puede
          escoger otro id_cliente.
        */

        data.id_cliente =
          idCliente;


        /*
          Si envía id_huesped,
          comprobamos que el huésped
          pertenezca a una reserva suya.
        */

        if (
          data.id_huesped
        ) {

          const idClienteActual =
            await query(
              `
                SELECT r.id_cliente
                FROM huespedes h
                INNER JOIN reservas r
                  ON r.id = h.id_reserva
                WHERE h.id = ?
                LIMIT 1
              `,
              [data.id_huesped]
            );


          if (
            !idClienteActual[0] ||
            Number(
              idClienteActual[0].id_cliente
            ) !== Number(idCliente)
          ) {

            return res.status(403).json({
              message:
                'El huésped no pertenece al cliente actual'
            });
          }
        }
      }


      /* ===================================================
         HUÉSPEDES
      =================================================== */

      if (
        req.user?.rol === 'Cliente' &&
        table === 'huespedes'
      ) {

        if (
          !data.id_reserva
        ) {

          return res.status(422).json({
            message:
              'La reserva es obligatoria para crear un huésped'
          });
        }


        const reservaValida =
          await comprobarReservaCliente(
            req,
            data.id_reserva
          );


        if (!reservaValida) {

          return res.status(403).json({
            message:
              'No puedes agregar huéspedes a una reserva que no te pertenece'
          });
        }
      }


      /*
        Contraseña de usuarios.
      */

      if (
        table === 'usuarios' &&
        data.contrasena
      ) {

        data.contrasena =
          await bcrypt.hash(
            data.contrasena,
            10
          );
      }


      const keys =
        Object.keys(data);


      if (!keys.length) {

        return res.status(422).json({
          message:
            'Sin datos'
        });
      }


      const placeholders =
        keys
          .map(() => '?')
          .join(',');


      const values =
        keys.map(
          key => data[key]
        );


      const [result] =
        await query(
          `
            INSERT INTO ${table}
            (${keys.join(',')})
            VALUES (${placeholders})
          `,
          values
        );


      return res.status(201).json({
        id: result.insertId,
        message:
          'Creado correctamente'
      });

    } catch (e) {

      if (
        e.code === 'ER_DUP_ENTRY'
      ) {

        return res.status(409).json({
          message:
            'Registro duplicado'
        });
      }

      next(e);
    }
  };


/* =========================================================
   EDITAR
========================================================= */

export const genericUpdate =
  table => async (
    req,
    res,
    next
  ) => {

    try {

      if (
        !safeTables.has(table)
      ) {

        return res.status(400).json({
          message:
            'Tabla no permitida'
        });
      }


      const puedeEditar =
        await tienePermiso(
          req,
          'editar'
        );

      if (!puedeEditar) {

        return accesoDenegado(
          res,
          'editar'
        );
      }


      /*
        Cliente no puede editar
        tablas administrativas.
      */

      if (
        req.user?.rol === 'Cliente' &&
        TABLAS_ADMIN.has(table)
      ) {

        return res.status(403).json({
          message:
            'No puedes editar registros de este módulo'
        });
      }


      /*
        Cliente solamente puede
        editar huéspedes y feedback.
      */

      if (
        req.user?.rol === 'Cliente' &&
        !CLIENTE_PUEDE_EDITAR.has(table)
      ) {

        return res.status(403).json({
          message:
            'No tienes permiso para editar este módulo'
        });
      }


      /*
        Comprobar que el registro
        pertenece al cliente.
      */

      if (
        req.user?.rol === 'Cliente'
      ) {

        const propietario =
          await comprobarPropiedadCliente(
            req,
            table,
            req.params.id
          );


        if (!propietario) {

          return res.status(403).json({
            message:
              'No puedes editar un registro que no te pertenece'
          });
        }
      }


      const data =
        cleanData(
          table,
          req.body
        );


      /*
        Cliente nunca puede cambiar
        el propietario del feedback.
      */

      if (
        req.user?.rol === 'Cliente' &&
        table === 'encuestas_feedback'
      ) {

        delete data.id_cliente;


        /*
          Si intenta cambiar id_huesped,
          comprobamos que pertenezca
          a una reserva suya.
        */

        if (
          data.id_huesped
        ) {

          const idCliente =
            await obtenerIdCliente(req);


          const rows =
            await query(
              `
                SELECT r.id_cliente
                FROM huespedes h
                INNER JOIN reservas r
                  ON r.id = h.id_reserva
                WHERE h.id = ?
                LIMIT 1
              `,
              [data.id_huesped]
            );


          if (
            !rows[0] ||
            Number(rows[0].id_cliente) !==
              Number(idCliente)
          ) {

            return res.status(403).json({
              message:
                'El huésped no pertenece al cliente actual'
            });
          }
        }
      }


      /*
        Contraseña de usuarios.
      */

      if (
        table === 'usuarios' &&
        data.contrasena
      ) {

        data.contrasena =
          await bcrypt.hash(
            data.contrasena,
            10
          );
      }


      const keys =
        Object.keys(data);


      if (!keys.length) {

        return res.status(422).json({
          message:
            'Sin cambios'
        });
      }


      const assignments =
        keys
          .map(
            key => `${key} = ?`
          )
          .join(',');


      const values =
        keys.map(
          key => data[key]
        );


      values.push(
        req.params.id
      );


      const [result] =
        await query(
          `
            UPDATE ${table}
            SET ${assignments}
            WHERE id = ?
          `,
          values
        );


      if (
        result.affectedRows === 0
      ) {

        return res.status(404).json({
          message:
            'Registro no encontrado'
        });
      }


      return res.json({
        message:
          'Actualizado correctamente'
      });

    } catch (e) {

      if (
        e.code === 'ER_DUP_ENTRY'
      ) {

        return res.status(409).json({
          message:
            'Registro duplicado'
        });
      }

      next(e);
    }
  };


/* =========================================================
   ELIMINAR
========================================================= */

export const genericDelete =
  table => async (
    req,
    res,
    next
  ) => {

    try {

      if (
        !safeTables.has(table)
      ) {

        return res.status(400).json({
          message:
            'Tabla no permitida'
        });
      }


      const puedeEliminar =
        await tienePermiso(
          req,
          'eliminar'
        );


      if (!puedeEliminar) {

        return accesoDenegado(
          res,
          'eliminar'
        );
      }


      /*
        Cliente nunca puede eliminar.
      */

      if (
        req.user?.rol === 'Cliente'
      ) {

        return res.status(403).json({
          message:
            'Los clientes no tienen permiso para eliminar registros'
        });
      }


      const [result] =
        await query(
          `
            DELETE FROM ${table}
            WHERE id = ?
          `,
          [req.params.id]
        );


      if (
        result.affectedRows === 0
      ) {

        return res.status(404).json({
          message:
            'Registro no encontrado'
        });
      }


      return res.json({
        message:
          'Eliminado correctamente'
      });

    } catch (e) {

      next(e);
    }
  };
