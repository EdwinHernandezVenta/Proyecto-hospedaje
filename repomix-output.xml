import Dashboard from './pages/Dashboard';
import Reservas from './pages/Reservas';
import Module from './pages/Module';
import Roles from './pages/Roles';

import './styles/global.css';


/*
  Módulos disponibles para Administrador y Cliente.
  Usuarios y Clientes quedan fuera porque son
  módulos exclusivos del Administrador.
*/
const clientModules = [
  'habitaciones',
  'servicios',
  'paquetes',
  'huespedes',
  'feedback'
];


function App() {
  return (
    <Routes>

      {/* =========================
          PARTE PÚBLICA
      ========================== */}

      <Route
        path="/"
        element={<Home />}
      />

      <Route
        path="/login"
        element={<Login />}
      />

      <Route
        path="/registro"
        element={<Register />}
      />

      <Route
        path="/recuperar-contrasena"
        element={<ForgotPassword />}
      />


      {/* =========================
          USUARIOS AUTENTICADOS
      ========================== */}

      <Route element={<Protected />}>

        <Route element={<Layout />}>

          {/* Reservas */}
          <Route
            path="/reservas"
            element={<Reservas />}
          />


          {/* Módulos disponibles para Cliente */}
          {clientModules.map((module) => (
            <Route
              key={module}
              path={`/${module}`}
              element={<Module name={module} />}
            />
          ))}


          {/* Perfil
              Temporalmente utiliza el módulo clientes.
              Más adelante crearemos el perfil propio del Cliente.
          */}
          <Route
            path="/perfil"
            element={<Module name="clientes" />}
          />


          {/* =========================
              SOLO ADMINISTRADOR
          ========================== */}

          <Route
            element={<Protected role="Administrador" />}
          >

            {/* Dashboard */}
            <Route
              path="/dashboard"
              element={<Dashboard />}
            />

            {/* Gestión de Roles */}
            <Route
              path="/roles"
              element={<Roles />}
            />

            {/* Gestión de Usuarios */}
            <Route
              path="/usuarios"
              element={<Module name="usuarios" />}
            />

            {/* Gestión de Clientes */}
            <Route
              path="/clientes"
              element={<Module name="clientes" />}
            />

          </Route>

        </Route>

      </Route>


      {/* =========================
          RUTA NO ENCONTRADA
      ========================== */}

      <Route
        path="*"
        element={<Navigate to="/" replace />}
      />

    </Routes>
  );
}


createRoot(
  document.getElementById('root')
).render(
  <React.StrictMode>

    <HashRouter>

      <AuthProvider>
        <App />
      </AuthProvider>

    </HashRouter>

  </React.StrictMode>
);
</file>

