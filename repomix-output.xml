import React, { useState } from 'react';
import { Link, useNavigate } from 'react-router-dom';
import { api } from '../api/http';
import './Register.css';

export default function Register() {
  const navigate = useNavigate();

  const [form, setForm] = useState({
    nombre_usuario: '',
    correo: '',
    contrasena: '',
    confirmarContrasena: '',
    identificacion: '',
    nombre: '',
    apellido: '',
    telefono: '',
    direccion: '',
    rolSolicitado: 'Cliente',
    codigoAdministrador: ''
  });

  const [error, setError] = useState('');
  const [exito, setExito] = useState('');
  const [cargando, setCargando] = useState(false);

  const cambiarCampo = (e) => {
    const { name, value } = e.target;

    setForm((actual) => ({
      ...actual,
      [name]: value
    }));

    setError('');
    setExito('');
  };

  const cambiarRol = (e) => {
    const rol = e.target.value;

    setForm((actual) => ({
      ...actual,
      rolSolicitado: rol,
      codigoAdministrador:
        rol === 'Administrador'
          ? actual.codigoAdministrador
          : ''
    }));

    setError('');
    setExito('');
  };

  const registrar = async (e) => {
    e.preventDefault();

    setError('');
    setExito('');

    if (
      !form.nombre_usuario ||
      !form.correo ||
      !form.contrasena ||
      !form.confirmarContrasena ||
      !form.identificacion ||
      !form.nombre ||
      !form.apellido
    ) {
      setError('Completa todos los campos obligatorios.');
      return;
    }

    if (form.contrasena !== form.confirmarContrasena) {
      setError('Las contraseñas no coinciden.');
      return;
    }

    if (form.contrasena.length < 8) {
      setError(
        'La contraseña debe tener mínimo 8 caracteres.'
      );
      return;
    }

    if (!/[A-Z]/.test(form.contrasena)) {
      setError(
        'La contraseña debe contener al menos una mayúscula.'
      );
      return;
    }

    if (!/[a-z]/.test(form.contrasena)) {
      setError(
        'La contraseña debe contener al menos una minúscula.'
      );
      return;
    }

    if (!/[0-9]/.test(form.contrasena)) {
      setError(
        'La contraseña debe contener al menos un número.'
      );
      return;
    }

    if (
      form.rolSolicitado === 'Administrador' &&
      !form.codigoAdministrador.trim()
    ) {
      setError(
        'Para crear una cuenta de Administrador debes ingresar el código de administrador.'
      );
      return;
    }

    try {
      setCargando(true);

      const response = await api.post(
        '/auth/register',
        {
          nombre_usuario: form.nombre_usuario,
          correo: form.correo,
          contrasena: form.contrasena,
          identificacion: form.identificacion,
          nombre: form.nombre,
          apellido: form.apellido,
          telefono: form.telefono,
          direccion: form.direccion,
          rolSolicitado: form.rolSolicitado,
          codigoAdministrador:
            form.rolSolicitado === 'Administrador'
              ? form.codigoAdministrador
              : ''
        }
      );

      setExito(
        response?.data?.message ||
        'Cuenta creada correctamente. Redirigiendo al inicio de sesión...'
      );

      setTimeout(() => {
        navigate('/login', {
          replace: true
        });
      }, 1600);
    } catch (err) {
      setError(
        err?.response?.data?.message ||
        err?.response?.data?.error ||
        err?.message ||
        'Ocurrió un error al crear la cuenta.'
      );
    } finally {
      setCargando(false);
    }
  };

  return (
    <div className="register-page">

      <div className="register-background">
        <div className="register-glow register-glow-one" />
        <div className="register-glow register-glow-two" />
      </div>

      <div className="register-card">

        <div className="register-brand">
          <div className="register-logo">
            PR
          </div>

          <div>
            <strong>PAIE ROYALE</strong>
            <span>HOTEL & RESORT</span>
          </div>
        </div>

        <div className="register-heading">
          <span>BIENVENIDO</span>

          <h1>
            Crear una cuenta
          </h1>

          <p>
            Regístrate para disfrutar de la experiencia
            PAIE ROYALE.
          </p>
        </div>

        {error && (
          <div className="register-message register-error">
            {error}
          </div>
        )}

        {exito && (
          <div className="register-message register-success">
            {exito}
          </div>
        )}

        <form
          className="register-form"
          onSubmit={registrar}
        >

          {/* TIPO DE CUENTA */}

          <div className="register-role-section">

            <div className="register-section-title">
              TIPO DE CUENTA
            </div>

            <div className="register-role-options">

              <label
                className={
                  `register-role-card ${
                    form.rolSolicitado === 'Cliente'
                      ? 'selected'
                      : ''
                  }`
                }
              >
                <input
                  type="radio"
                  name="rolSolicitado"
                  value="Cliente"
                  checked={
                    form.rolSolicitado === 'Cliente'
                  }
                  onChange={cambiarRol}
                />

                <div className="register-role-icon">
                  👤
                </div>

                <div className="register-role-content">
                  <strong>Cliente</strong>

                  <span>
                    Reservas, habitaciones,
                    servicios y perfil personal.
                  </span>
                </div>

                <div className="register-role-check">
                  {form.rolSolicitado === 'Cliente'
                    ? '✓'
                    : ''}
                </div>
              </label>

              <label
                className={
                  `register-role-card ${
                    form.rolSolicitado === 'Administrador'
                      ? 'selected admin'
                      : ''
                  }`
                }
              >
                <input
                  type="radio"
                  name="rolSolicitado"
                  value="Administrador"
                  checked={
                    form.rolSolicitado ===
                    'Administrador'
                  }
                  onChange={cambiarRol}
                />

                <div className="register-role-icon">
                  ♛
                </div>

                <div className="register-role-content">
                  <strong>Administrador</strong>

                  <span>
                    Gestión completa del sistema
                    y módulos administrativos.
                  </span>
                </div>

                <div className="register-role-check">
                  {form.rolSolicitado ===
                  'Administrador'
                    ? '✓'
                    : ''}
                </div>
              </label>

            </div>

          </div>

          {/* DATOS DE CUENTA */}

          <div className="register-section-title">
            DATOS DE LA CUENTA
          </div>

          <div className="register-grid">

            <label>
              <span>
                Nombre de usuario *
              </span>

              <input
                type="text"
                name="nombre_usuario"
                value={form.nombre_usuario}
                onChange={cambiarCampo}
                placeholder="Ej. juanperez"
                maxLength={50}
                autoComplete="username"
                required
              />
            </label>

            <label>
              <span>
