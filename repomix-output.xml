              />
            </label>

            <label>
              <span>
                Teléfono
              </span>

              <input
                type="tel"
                name="telefono"
                value={form.telefono}
                onChange={cambiarCampo}
                placeholder="Número de teléfono"
                autoComplete="tel"
              />
            </label>

            <label className="register-full">
              <span>
                Dirección
              </span>

              <input
                type="text"
                name="direccion"
                value={form.direccion}
                onChange={cambiarCampo}
                placeholder="Dirección"
                maxLength={100}
                autoComplete="street-address"
              />
            </label>

          </div>

          {/* CODIGO ADMINISTRADOR */}

          {form.rolSolicitado === 'Administrador' && (
            <div className="register-admin-code">

              <div className="register-admin-code-title">
                <span>♛</span>
                AUTORIZACIÓN DE ADMINISTRADOR
              </div>

              <p>
                Esta cuenta tendrá acceso a los módulos
                administrativos. Se requiere un código
                de autorización.
              </p>

              <label>
                <span>
                  Código de administrador *
                </span>

                <input
                  type="password"
                  name="codigoAdministrador"
                  value={
                    form.codigoAdministrador
                  }
                  onChange={cambiarCampo}
                  placeholder="Ingresa el código de autorización"
