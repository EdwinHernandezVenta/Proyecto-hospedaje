        </form>

        <div className="register-footer">
          <span>
            ¿Ya tienes una cuenta?
          </span>

          <Link to="/login">
            Iniciar sesión
          </Link>
        </div>

        <Link
          to="/"
          className="register-home"
        >
          ← Volver a PAIE ROYALE
        </Link>

      </div>

    </div>
  );
}
