import { useEffect,useState } from 'react';
import { api } from '../api/http';

const money=n=>`$${Number(n||0).toLocaleString('es-CO')}`;

export default function Dashboard(){
  const [s,setS]=useState(null);
  const [error,setError]=useState('');

  useEffect(()=>{
    api.get('/dashboard/estadisticas')
      .then(x=>setS(x.data))
      .catch(x=>setError(x.response?.data?.message||'No se pudo cargar el dashboard'));
  },[]);

  if(error) return <div className="notice error">{error}</div>;
  if(!s) return <div className="card">Cargando centro de control…</div>;

  const max=Math.max(...(s.ventasMensuales||[]).map(x=>Number(x.ventas)||0),1);
  const estados=s.reservasPorEstado||[];

  return (
    <section>
      <div className="page-title">
        <h1>Centro de control</h1>
        <p>Resumen operativo de tu sistema de hospedaje.</p>
      </div>

      <div className="stats">
        <div className="stat-card"><span className="stat-icon">◫</span><span className="stat-label">RESERVAS ACTIVAS</span><strong className="stat-value">{s.reservas}</strong></div>
        <div className="stat-card"><span className="stat-icon">◉</span><span className="stat-label">CLIENTES</span><strong className="stat-value">{s.clientes}</strong></div>
        <div className="stat-card"><span className="stat-icon">♧</span><span className="stat-label">HUÉSPEDES</span><strong className="stat-value">{s.huespedes}</strong></div>
        <div className="stat-card"><span className="stat-icon">★</span><span className="stat-label">CALIFICACIÓN</span><strong className="stat-value">{Number(s.calificacionPromedio||0).toFixed(1)}</strong></div>
      </div>

      <div className="dashboard-grid">
        <div className="card">
          <div className="title"><div><h3>Rendimiento mensual</h3><p style={{color:'var(--muted)'}}>Pagos confirmados</p></div></div>
          {(s.ventasMensuales||[]).length ? (s.ventasMensuales.map(x=>(
            <div className="chart-row" key={x.mes}>
              <span>{x.mes}</span>
              <div className="bar-track"><div className="bar-fill" style={{width:`${Math.max(Number(x.ventas)/max*100,3)}%`}}/></div>
              <b>{money(x.ventas)}</b>
            </div>
          ))) : <div className="empty">Aún no hay pagos confirmados.</div>}
        </div>

        <div className="card">
