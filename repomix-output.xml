import { query } from '../config/db.js';
import bcrypt from 'bcryptjs';
import jwt from 'jsonwebtoken';
import crypto from 'crypto';

const tokens = new Map();

/* =========================================================
   LOGIN
   ========================================================= */

export async function login(req, res, next) {
  try {
    const {
      correo,
      contrasena
    } = req.body;

    const rows = await query(
      `
        SELECT
          u.*,
          r.nombre_rol
        FROM usuarios u
        JOIN roles r
          ON r.id = u.id_rol
        WHERE u.correo = ?
        LIMIT 1
      `,
      [correo]
    );

    if (
      !rows[0] ||
      rows[0].estado !== 'activo' ||
      !(await bcrypt.compare(
        contrasena,
        rows[0].contrasena
      ))
    ) {
      return res.status(401).json({
        message: 'Correo o contraseña incorrectos'
      });
    }

    const u = rows[0];

    const access = jwt.sign(
      {
        id: u.id,
        correo: u.correo,
        rol: u.nombre_rol
      },
      process.env.JWT_SECRET,
      {
        expiresIn: '15m'
      }
    );

    const refresh = jwt.sign(
      {
        id: u.id
      },
      process.env.JWT_REFRESH_SECRET,
      {
        expiresIn: '7d'
      }
    );

    tokens.set(refresh, u.id);

    res.json({
      accessToken: access,
      refreshToken: refresh,

      user: {
        id: u.id,
        nombre: u.nombre_usuario,
        correo: u.correo,
        rol: u.nombre_rol
      }
    });

  } catch (e) {
    next(e);
  }
}

/* =========================================================
   LOGOUT
   ========================================================= */

export async function logout(req, res) {
  res.json({
    message: 'Sesión cerrada'
  });
}

/* =========================================================
   RECUPERAR CONTRASEÑA
   VERSIÓN LOCAL DE PRUEBA
   ========================================================= */

export async function forgot(req, res, next) {
  try {
    const correo = req.body.correo?.trim();

    if (!correo) {
      return res.status(400).json({
        message: 'El correo es obligatorio'
      });
    }

    const usuarios = await query(
      `
        SELECT
          id,
          correo,
          estado
        FROM usuarios
        WHERE correo = ?
        LIMIT 1
      `,
      [correo]
    );

    if (!usuarios.length) {
      return res.status(404).json({
        message: 'No existe una cuenta registrada con ese correo'
      });
    }

    const usuario = usuarios[0];

    if (usuario.estado !== 'activo') {
      return res.status(400).json({
        message: 'La cuenta no está activa'
      });
    }

    /*
      Generamos un token temporal.

      En esta versión de prueba NO se envía por correo.
      Se devuelve en la respuesta para poder probar
      todo el proceso localmente.
    */
    const token = crypto
      .randomBytes(24)
      .toString('hex');

    const url =
      `${process.env.CLIENT_URL}/reset-password?token=${token}`;

    await query(
      `
        INSERT INTO password_resets
        (
          id_usuario,
          token,
          url,
          expiracion
        )
        VALUES
        (
          ?,
          ?,
          ?,
          DATE_ADD(NOW(), INTERVAL 30 MINUTE)
        )
      `,
      [
        usuario.id,
        token,
        url
      ]
    );

    res.json({
      message:
        'Solicitud de recuperación creada correctamente',

      /*
        SOLO PARA PRUEBAS LOCALES.
        Más adelante eliminaremos este campo
        y enviaremos el enlace por correo.
      */
      token,

      url
    });

  } catch (e) {
    next(e);
  }
}

/* =========================================================
   RESTABLECER CONTRASEÑA
   ========================================================= */

export async function reset(req, res, next) {
  try {
    const {
      token,
      nuevaContrasena
    } = req.body;

    if (!token) {
      return res.status(400).json({
        message: 'El código de recuperación es obligatorio'
      });
    }

    if (!nuevaContrasena) {
      return res.status(400).json({
        message: 'La nueva contraseña es obligatoria'
      });
    }

    const registros = await query(
      `
        SELECT
          *
        FROM password_resets
        WHERE token = ?
          AND usado = FALSE
          AND expiracion > NOW()
        LIMIT 1
      `,
      [token]
    );

    if (!registros.length) {
      return res.status(400).json({
        message:
          'El código de recuperación es inválido o ya expiró'
      });
    }

    const recuperacion = registros[0];

    const hash = await bcrypt.hash(
      nuevaContrasena,
      10
    );

    await query(
      `
        UPDATE usuarios
        SET contrasena = ?
        WHERE id = ?
      `,
      [
        hash,
        recuperacion.id_usuario
      ]
    );

    await query(
      `
        UPDATE password_resets
        SET usado = TRUE
        WHERE id = ?
      `,
      [recuperacion.id]
    );

    res.json({
      message:
        'Contraseña restablecida correctamente'
    });

  } catch (e) {
    next(e);
  }
}
