  0%,
  100% {
    transform:
      translate(-50%, -50%)
      rotateY(-17deg)
      rotateX(7deg)
      translateY(0);
  }

  50% {
    transform:
      translate(-50%, -50%)
      rotateY(-12deg)
      rotateX(4deg)
      translateY(-15px);
  }

}


@keyframes prGlowMove {

