import dotenv from 'dotenv';
import bcrypt from 'bcryptjs';
import { query, pool } from '../config/db.js';

dotenv.config();

export async function registrarUsuario(req, res, next) {
  let connection;

  try {
    const {
      nombre_usuario,
      correo,
      contrasena,
      identificacion,
      nombre,
      apellido,
      telefono,
      direccion,
      rolSolicitado,
      codigoAdministrador
    } = req.body;

    const usuario = String(nombre_usuario || '').trim();
    const email = String(correo || '').trim().toLowerCase();
    const password = String(contrasena || '').trim();

    const nombreCliente = String(nombre || '').trim();
    const apellidoCliente = String(apellido || '').trim();

    const identificacionNumero = Number(identificacion);

    const rol =
      rolSolicitado === 'Administrador'
        ? 'Administrador'
        : 'Cliente';

    /* ================================
       VALIDACIONES
       ================================ */

    if (!usuario) {
      return res.status(400).json({
        message: 'El nombre de usuario es obligatorio'
      });
    }

    if (usuario.length < 3 || usuario.length > 50) {
      return res.status(400).json({
        message: 'El usuario debe tener entre 3 y 50 caracteres'
      });
    }

    if (!email) {
      return res.status(400).json({
        message: 'El correo es obligatorio'
      });
    }

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      return res.status(400).json({
        message: 'Ingresa un correo electrónico válido'
      });
    }

    if (!password) {
      return res.status(400).json({
        message: 'La contraseña es obligatoria'
      });
    }

    if (password.length < 8) {
      return res.status(400).json({
        message: 'La contraseña debe tener mínimo 8 caracteres'
      });
    }

    if (!/[A-Z]/.test(password)) {
      return res.status(400).json({
        message: 'La contraseña debe contener al menos una mayúscula'
      });
    }

    if (!/[a-z]/.test(password)) {
      return res.status(400).json({
        message: 'La contraseña debe contener al menos una minúscula'
      });
    }

    if (!/[0-9]/.test(password)) {
      return res.status(400).json({
        message: 'La contraseña debe contener al menos un número'
      });
    }

    if (!nombreCliente) {
      return res.status(400).json({
        message: 'El nombre es obligatorio'
      });
    }

    if (!apellidoCliente) {
      return res.status(400).json({
        message: 'El apellido es obligatorio'
      });
    }

    if (
      !Number.isInteger(identificacionNumero) ||
      identificacionNumero <= 0
    ) {
      return res.status(400).json({
        message: 'La identificación debe ser un número válido'
      });
    }

    /* ================================
       VALIDACIÓN DE ADMINISTRADOR
       ================================ */

    if (rol === 'Administrador') {
      const codigoReal =
        String(process.env.ADMIN_REGISTRATION_CODE || '').trim();

      const codigoRecibido =
        String(codigoAdministrador || '').trim();

      if (!codigoReal) {
        return res.status(500).json({
          message:
            'El registro de administradores no está configurado en el servidor'
        });
      }

      if (codigoRecibido !== codigoReal) {
        return res.status(403).json({
          message: 'El código de administrador es incorrecto'
        });
      }
    }

    /* ================================
       COMPROBAR USUARIO
       ================================ */

    const usuarioExistente = await query(
      `
        SELECT id
        FROM usuarios
        WHERE correo = ?
        LIMIT 1
      `,
      [email]
    );

    if (usuarioExistente.length > 0) {
      return res.status(409).json({
        message:
          'Ya existe una cuenta registrada con ese correo'
      });
    }

    const nombreUsuarioExistente = await query(
      `
        SELECT id
        FROM usuarios
        WHERE nombre_usuario = ?
        LIMIT 1
      `,
      [usuario]
    );

    if (nombreUsuarioExistente.length > 0) {
      return res.status(409).json({
        message:
          'Ese nombre de usuario ya está en uso'
      });
    }

    /* ================================
       COMPROBAR CLIENTE
       ================================ */

    const clienteExistente = await query(
      `
        SELECT id
        FROM clientes
        WHERE identificacion = ?
        LIMIT 1
      `,
      [identificacionNumero]
    );

    if (clienteExistente.length > 0) {
      return res.status(409).json({
        message:
          'Ya existe un cliente con esa identificación'
      });
    }

    const clienteCorreoExistente = await query(
      `
        SELECT id
        FROM clientes
        WHERE correo = ?
        LIMIT 1
      `,
      [email]
    );

    if (clienteCorreoExistente.length > 0) {
      return res.status(409).json({
        message:
          'Ese correo ya está registrado como cliente'
      });
    }

    /* ================================
       BUSCAR ROL
       ================================ */

    const roles = await query(
      `
        SELECT
          id,
          nombre_rol
        FROM roles
        WHERE nombre_rol = ?
          AND estado_rol = TRUE
        LIMIT 1
      `,
      [rol]
    );

    if (!roles.length) {
      return res.status(500).json({
        message:
          `No se encontró el rol ${rol} activo en el sistema`
      });
    }

    const idRol = roles[0].id;

    /* ================================
       ENCRIPTAR CONTRASEÑA
       ================================ */

    const hash = await bcrypt.hash(
      password,
      10
    );

    /* ================================
       TRANSACCIÓN
       ================================ */

    connection = await pool.getConnection();

    await connection.beginTransaction();

    /* ================================
       CREAR USUARIO
       ================================ */

    const [usuarioResult] =
      await connection.execute(
        `
          INSERT INTO usuarios
          (
            nombre_usuario,
            correo,
            contrasena,
            id_rol,
            estado
          )
          VALUES (?, ?, ?, ?, 'activo')
        `,
        [
          usuario,
          email,
          hash,
          idRol
        ]
      );

    /* ================================
       CREAR CLIENTE
       ================================ */

    const telefonoValor =
      telefono &&
      String(telefono).trim()
        ? Number(
            String(telefono).replace(/\D/g, '')
          )
        : null;

    await connection.execute(
      `
        INSERT INTO clientes
        (
          identificacion,
          nombre,
          apellido,
          telefono,
          direccion,
          correo,
          estado
        )
        VALUES (?, ?, ?, ?, ?, ?, TRUE)
      `,
      [
        identificacionNumero,
        nombreCliente,
        apellidoCliente,
        telefonoValor || null,
        direccion
          ? String(direccion).trim()
          : null,
        email
      ]
    );

    /* ================================
       CONFIRMAR
       ================================ */

    await connection.commit();

    return res.status(201).json({
      message:
        rol === 'Administrador'
          ? 'Cuenta de Administrador creada correctamente'
          : 'Cuenta de Cliente creada correctamente',

      usuario: {
        id: usuarioResult.insertId,
        nombre_usuario: usuario,
        correo: email,
        rol
      }
    });

  } catch (error) {

    if (connection) {
      try {
        await connection.rollback();
      } catch {}
    }

    if (error?.code === 'ER_DUP_ENTRY') {
      return res.status(409).json({
        message:
          'Ya existe una cuenta o cliente con esos datos'
      });
    }

    next(error);

  } finally {

    if (connection) {
      connection.release();
    }
  }
}
