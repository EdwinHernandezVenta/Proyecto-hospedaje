import { useEffect, useMemo, useState } from 'react';
import { api } from '../api/http';
import { useAuth } from '../context/AuthContext';

const fields = {
  roles: ['nombre_rol', 'permisos', 'estado_rol'],
  usuarios: ['nombre_usuario', 'correo', 'contrasena', 'id_rol', 'estado'],
  habitaciones: [
    'numero_habitacion',
    'tipo_habitacion',
    'capacidad_maxima',
    'descripcion',
    'comodidades',
    'tarifa',
    'estado'
  ],
  servicios: [
    'nombre_servicio',
    'descripcion',
    'categoria',
    'costo',
    'disponibilidad',
    'observacion',
    'estado'
  ],
  paquetes: [
    'nombre',
    'descripcion',
    'precio',
    'disponibilidad',
    'estado',
    'destino',
    'condiciones'
  ],
  clientes: [
    'identificacion',
    'nombre',
    'apellido',
    'telefono',
    'direccion',
    'correo',
    'estado'
  ],
  huespedes: [
    'documento',
    'nombres',
    'apellidos',
    'fecha_nacimiento',
    'correo',
    'departamento',
    'ciudad',
    'direccion',
    'celular',
    'id_reserva',
    'estado'
  ],
  feedback: [
    'id_cliente',
    'id_huesped',
    'calificacion',
    'comentario',
    'anonimo'
  ]
};

const labels = {
  numero_habitacion: 'Número',
  tipo_habitacion: 'Tipo',
  capacidad_maxima: 'Capacidad',
  nombre_servicio: 'Servicio',
  nombre_usuario: 'Usuario',
  id_rol: 'ID Rol',
  nombre: 'Nombre',
  id_cliente: 'ID Cliente',
  id_huesped: 'ID Huésped',
  id_reserva: 'ID Reserva',
  valor_total: 'Valor total'
};

const CLIENTE_CREAR = [
  'huespedes',
  'feedback'
];

const CLIENTE_EDITAR = [
  'huespedes',
  'feedback'
];

export default function Module({ name }) {
  const { user } = useAuth();

  const [data, setData] = useState({
    rows: [],
    total: 0
  });

  const [form, setForm] = useState({});
  const [search, setSearch] = useState('');
  const [msg, setMsg] = useState('');
  const [loading, setLoading] = useState(false);

  const fs = fields[name] || [];

  const esCliente = user?.rol === 'Cliente';
  const esAdministrador = user?.rol === 'Administrador';

  /*
    El Administrador puede crear.
    El Cliente solamente puede crear en módulos
    permitidos para su rol.
  */
  const puedeCrear =
    esAdministrador ||
    (esCliente && CLIENTE_CREAR.includes(name));

  /*
    El Administrador puede editar.
    El Cliente solamente puede editar registros
    en módulos permitidos para su rol.
  */
  const puedeEditar =
    esAdministrador ||
    (esCliente && CLIENTE_EDITAR.includes(name));

  /*
    Eliminar queda exclusivamente para Administrador.
  */
  const puedeEliminar = esAdministrador;


  async function load() {
    setLoading(true);

    try {
      const response = await api.get(`/${name}`, {
        params: {
          search,
          limit: 50
        }
      });

      setData(response.data);
      setMsg('');
    } catch (error) {
      setMsg(
        error.response?.data?.message ||
        'No se pudieron cargar los datos'
      );
    } finally {
      setLoading(false);
    }
  }


  useEffect(() => {
    load();
  }, [name, search]);


  function handleChange(field, value) {
    setForm((previous) => ({
      ...previous,
      [field]: value
    }));
  }


  async function save(event) {
    event.preventDefault();

    if (!puedeCrear) {
      setMsg(
        'No tienes permiso para crear registros en este módulo.'
      );
      return;
    }

    try {
      await api.post(`/${name}`, form);

      setForm({});

      setMsg('✓ Guardado correctamente');

      await load();

    } catch (error) {
      setMsg(
        error.response?.data?.message ||
        'Error al guardar'
      );
    }
  }


  async function edit(row) {
    if (!puedeEditar) {
      setMsg(
        'No tienes permiso para editar este módulo.'
      );
      return;
    }

    /*
      Para mantener esta primera versión segura,
      cargamos los datos actuales en el formulario.
    */
    const editable = {};

    fs.forEach((field) => {
      if (row[field] !== undefined && row[field] !== null) {
        editable[field] = row[field];
      }
    });

    setForm(editable);

    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });

    setMsg(
      `Editando registro #${row.id}`
    );
  }


  async function update(event) {
    event.preventDefault();

    if (!puedeEditar) {
      setMsg(
        'No tienes permiso para editar registros.'
      );
      return;
    }

    if (!form.id) {
      setMsg(
        'Selecciona primero un registro para editar.'
      );
      return;
    }

    try {
      const { id, ...datos } = form;

      await api.put(
        `/${name}/${id}`,
        datos
      );

      setForm({});

      setMsg(
        '✓ Registro actualizado correctamente'
      );

      await load();

    } catch (error) {
      setMsg(
        error.response?.data?.message ||
        'No se pudo actualizar el registro'
      );
    }
  }


  function cancelarEdicion() {
    setForm({});
    setMsg('');
  }


  async function del(id) {
    if (!puedeEliminar) {
      setMsg(
        'No tienes permiso para eliminar registros.'
      );
      return;
    }

    if (
      !window.confirm(
        '¿Seguro que quieres eliminar este registro?'
      )
    ) {
      return;
    }

    try {
      await api.delete(
        `/${name}/${id}`
      );

      setMsg(
        '✓ Registro eliminado'
      );

      await load();

    } catch (error) {
      setMsg(
        error.response?.data?.message ||
        'No se pudo eliminar'
      );
    }
  }


  const title =
    name === 'huespedes'
      ? 'Huéspedes'
      : name.charAt(0).toUpperCase() +
        name.slice(1);


  const columns = useMemo(
    () =>
      data.rows?.[0]
        ? Object.keys(data.rows[0])
        : fs,
    [data.rows, fs]
  );


  const editando = Boolean(form.id);


  return (
    <section>

      {/* =========================
          CABECERA
      ========================== */}

      <div className="title">

        <div className="page-title">

          <h1>
            {title}
          </h1>

          <p>
            Gestión y consulta de{' '}
            {title.toLowerCase()}.
          </p>

        </div>


        <input
          style={{ maxWidth: 240 }}
          placeholder="⌕ Buscar…"
          value={search}
          onChange={(event) =>
            setSearch(event.target.value)
          }
        />

      </div>


      {/* =========================
          FORMULARIO
      ========================== */}

      {puedeCrear && (

        <form
          className="card form"
          onSubmit={
            editando
              ? update
              : save
          }
        >

          {fs.map((field) => (

            <div
              className="field"
              key={field}
            >

              <label>
                {labels[field] ||
                  field
                    .replaceAll('_', ' ')
                    .toUpperCase()}
              </label>


              <input
                type={
                  field === 'contrasena'
                    ? 'password'
                    : field.includes('fecha')
                      ? 'date'
                      : 'text'
                }
                placeholder={
                  labels[field] || field
                }
                value={
                  form[field] ?? ''
                }
                onChange={(event) =>
                  handleChange(
                    field,
                    event.target.value
                  )
                }
              />

            </div>

          ))}


          <div className="form-actions">

            <button
              type="submit"
              className="primary"
            >
              {editando
                ? 'Guardar cambios'
                : '+ Crear'}
            </button>


            {editando && (

              <button
                type="button"
                className="secondary"
                onClick={cancelarEdicion}
              >
                Cancelar
              </button>

            )}

          </div>

        </form>

      )}


      {/* =========================
          MENSAJE
      ========================== */}

      {msg && (

        <div className="notice">
          {msg}
        </div>

      )}


      {/* =========================
          TABLA
      ========================== */}

      <div className="card">

        <div className="title">

          <h3>
            Registros
          </h3>

          <span
            style={{
              color: 'var(--muted)',
              fontSize: 12
            }}
          >
            {loading
              ? 'Actualizando…'
              : `${data.total || 0} registros`}
          </span>

        </div>


        <div className="tablewrap">

          <table>

            <thead>

              <tr>

                {columns.map((column) => (

                  <th key={column}>
                    {column.replaceAll(
                      '_',
                      ' '
                    )}
                  </th>

                ))}


                {(puedeEditar ||
                  puedeEliminar) && (

                  <th>
                    Acciones
                  </th>

                )}

              </tr>

            </thead>


            <tbody>

              {data.rows?.map((row) => (

                <tr key={row.id}>

                  {columns.map((column) => (

                    <td key={column}>
                      {String(
                        row[column] ?? ''
                      )}
                    </td>

                  ))}


                  {(puedeEditar ||
                    puedeEliminar) && (

                    <td>

                      {puedeEditar && (

                        <button
                          type="button"
                          className="secondary"
                          onClick={() =>
                            edit(row)
                          }
                        >
                          Editar
                        </button>

                      )}


                      {puedeEliminar && (

                        <button
                          type="button"
                          className="secondary danger"
                          onClick={() =>
                            del(row.id)
                          }
                        >
                          Eliminar
                        </button>

                      )}

                    </td>

                  )}

                </tr>

              ))}

            </tbody>

          </table>


          {!data.rows?.length && (

            <div className="empty">
              No hay registros para mostrar.
            </div>

          )}

        </div>

      </div>

    </section>
  );
}
</file>

